# ─────────────────────────────────────────────────────────────────────────────
# VedRith V1.0 — Environment Variables
# Copy to .env.local. NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin Panel (REQUIRED to unlock /admin) ──────────────────────────────────
# Generate: openssl rand -hex 32
VEDRITH_ADMIN_TOKEN=

# ── Supabase (REQUIRED for Kundali persistence & notifications in V2) ────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-ONLY — never in NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter (OPTIONAL — enriches Rules Engine explanations) ───────────────
# Get from: https://openrouter.ai — uses free models only
OPENROUTER_API_KEY=

# ── App URL (OPTIONAL — for canonical URLs) ─────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vedrith.sharvasit.in

# ── Build ID (AUTO-SET by Vercel) ────────────────────────────────────────────
# VERCEL_DEPLOYMENT_ID is automatically set by Vercel.
# NEXT_PUBLIC_BUILD_ID is stamped at build time from VERCEL_DEPLOYMENT_ID.
# Do not set manually in production.
