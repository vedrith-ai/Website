# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin authentication (HMAC-SHA-256)
VEDRITH_ADMIN_TOKEN=your-secure-admin-token-min-32-chars

# Event publishing secret
VEDRITH_EVENT_SECRET=your-secure-event-secret-min-32-chars

# App
NEXT_PUBLIC_APP_URL=https://vedrith.sharvasit.in
NODE_ENV=production
